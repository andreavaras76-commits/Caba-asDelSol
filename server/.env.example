NODE_ENV=development
PORT=4000

# MongoDB Atlas
MONGODB_URI=mongodb+srv://usuario:password@cluster.mongodb.net/cabanas-del-sol

# JWT
JWT_SECRET=cambiar-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=7d

# Orígenes permitidos (separados por coma)
CORS_ORIGINS=http://localhost:5173,https://delsoltafidelvalle.com.ar

# URL pública del sitio (para el sitemap)
SITE_URL=https://delsoltafidelvalle.com.ar

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=cabanas-del-sol

# Cuenta única de administración (la crea el seed si no existe ninguna)
SEED_ADMIN_NAME=Cabañas del Sol
SEED_ADMIN_USERNAME=CabañasDelSol
SEED_ADMIN_PASSWORD=CambiarEstaClave123!
